@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--green:#18b95f;--green-dark:#10984c;--green-soft:#eafaf1;--ink:#152033;--muted:#758092;--line:#e7eaf0;--surface:#f7f9fb;--danger:#e84b4b;--warning:#e8a324;--shadow:0 10px 28px rgba(21,32,51,.08)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:#fff;font-family:Inter,Segoe UI,sans-serif;font-size:14px}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{min-height:100vh}.app-staff{margin-left:230px}.sidebar{position:fixed;inset:0 auto 0 0;width:230px;padding:26px 16px;background:#fff;border-right:1px solid var(--line);z-index:30;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:9px;color:#fff;text-decoration:none;font-size:19px;font-weight:800}.brand-dark{color:var(--ink);padding:0 5px 24px}.brand-ball{display:grid;place-items:center;width:34px;height:34px;background:#fff;border-radius:11px;font-size:20px;box-shadow:0 2px 8px #0001}.side-nav{display:grid;gap:5px}.side-nav a{display:flex;align-items:center;gap:13px;padding:12px 14px;color:#687386;text-decoration:none;border-radius:11px;font-weight:500}.side-nav a:hover,.side-nav a.active{color:var(--green-dark);background:var(--green-soft)}.clock-card{margin-top:auto;display:flex;gap:11px;align-items:center;padding:12px;background:var(--green-soft);border:1px solid #d9f4e5;border-radius:12px}.clock-card>span{font-size:23px;color:var(--green-dark)}.clock-card small,.clock-card strong{display:block}.clock-card small{font-size:11px;color:var(--green-dark)}.clock-card strong{font-size:18px}.topbar{height:74px;margin:14px 18px 0;padding:11px 18px;background:linear-gradient(105deg,#13a951,#35d77d);border-radius:14px;box-shadow:0 5px 14px #18b95f33;display:flex;align-items:center;justify-content:space-between;position:sticky;top:10px;z-index:20}.app-staff .topbar{justify-content:flex-end}.top-search{margin-right:auto;width:min(410px,40vw);background:#ffffff18;border-color:#ffffff33}.top-search input{color:#fff}.top-search input::placeholder{color:#ffffffa8}.profile-menu{position:relative;color:#fff}.profile-menu summary{list-style:none;display:flex;align-items:center;gap:10px;cursor:pointer}.profile-menu summary::-webkit-details-marker{display:none}.profile-menu summary strong,.profile-menu summary small{display:block;max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.profile-menu summary small{font-size:10px;text-transform:uppercase;color:#effff5;margin-top:2px}.avatar,.mini-avatar{display:inline-grid;place-items:center;background:#fff;color:var(--green-dark);font-weight:800;border-radius:10px}.avatar{width:38px;height:38px}.mini-avatar{width:28px;height:28px;background:var(--green);color:#fff;margin-right:8px}.chevron{font-size:18px}.profile-dropdown{position:absolute;right:0;top:52px;width:245px;padding:14px;background:#fff;color:var(--ink);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}.profile-dropdown small{display:block;color:var(--muted);margin-top:4px}.profile-dropdown form{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}.profile-dropdown button{width:100%;padding:10px;border:0;border-radius:8px;color:#fff;background:var(--danger);font-weight:700}.mobile-menu{display:none;background:none;border:0;color:#fff;font-size:24px}.content{width:min(1180px,calc(100% - 38px));margin:0 auto;padding:46px 0 70px}.app-staff .content{width:min(1240px,calc(100% - 58px));padding-top:38px}.welcome,.page-heading,.section-title{display:flex;justify-content:space-between;align-items:center;gap:20px}.welcome{padding:12px 0 26px}.welcome h1,.page-heading h1{font-size:34px;line-height:1.1;margin:3px 0 9px}.welcome p,.page-heading p,.section-title p{margin:0;color:var(--muted)}.eyebrow{font-size:11px!important;color:var(--green-dark)!important;font-weight:800;letter-spacing:.14em}.search{height:44px;border:1px solid var(--line);border-radius:10px;display:flex;align-items:center;gap:9px;padding:0 13px}.search span{color:#98a1af;font-size:20px}.search input{width:100%;border:0;outline:0;background:transparent}.client-search{max-width:730px;margin-bottom:44px}.section-title{margin-bottom:20px}.section-title h2{font-size:23px;margin:0 0 5px}.count{min-width:34px;padding:7px 10px;text-align:center;background:var(--surface);border-radius:9px;font-weight:700}.court-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.court-card{overflow:hidden;border:1px solid var(--line);border-radius:15px;background:#fff;box-shadow:0 3px 10px #1520330a;transition:.2s}.court-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}.court-image{height:180px;position:relative;display:grid;place-items:center;background:linear-gradient(145deg,#c9f3db,#67cb8e);background-size:cover;background-position:center}.court-image>span{font-size:55px}.court-image b{position:absolute;right:12px;bottom:12px;padding:7px 9px;background:#132019df;color:#fff;border-radius:8px}.court-image b small{font-weight:400}.court-body{padding:16px}.court-body h3{font-size:18px;margin:0 0 5px}.location,.court-desc{color:var(--muted);font-size:12px}.court-desc{min-height:30px}.chips{display:flex;flex-wrap:wrap;gap:5px;margin:12px 0}.chips span,.badge{display:inline-block;padding:5px 8px;border-radius:999px;font-size:11px;font-weight:600}.chips span{color:var(--green-dark);background:var(--green-soft);border:1px solid #cef1dd}.btn{border:1px solid transparent;border-radius:9px;padding:11px 17px;font-weight:700}.btn-primary{color:#fff;background:var(--green)}.btn-primary:hover{background:var(--green-dark)}.btn-outline{color:var(--ink);background:#fff;border-color:#d9dde4}.btn-block{width:100%}.section-gap{margin-top:38px}.panel{padding:24px;border:1px solid var(--line);border-radius:15px;background:#fff}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px}.metric-grid article{display:flex;justify-content:space-between;align-items:center;padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.metric-grid small,.metric-grid strong{display:block}.metric-grid small{color:var(--muted);margin-bottom:7px}.metric-grid strong{font-size:28px}.metric-icon{display:grid;place-items:center;width:45px;height:45px;border-radius:12px;font-size:18px;font-weight:800}.metric-icon.green{background:#dcf9e8;color:#17a957}.metric-icon.blue{background:#e4efff;color:#397bd9}.metric-icon.purple{background:#f1e7ff;color:#8b46cc}.metric-icon.red{background:#ffe5e5;color:#d74a4a}.table-search{max-width:450px;margin:4px 0 18px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:820px}th,td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--line)}th{background:#fafafa;color:#929aa8;font-size:11px;text-transform:uppercase;letter-spacing:.04em}tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#fcfefd}.cell-sub{display:block;color:var(--muted);font-weight:400;margin-top:4px}.badge.success{color:#13964a;background:#e5f8ed}.badge.warning{color:#ac7412;background:#fff3d5}.badge.danger{color:#c23b3b;background:#ffe4e4}.badge.neutral{color:#677181;background:#f0f2f5}.actions{display:flex;gap:7px;align-items:center}.actions form{margin:0}.icon-btn{width:34px;height:34px;border:0;border-radius:8px;font-weight:800}.icon-btn.pay{color:#138f48;background:#e6f8ed}.icon-btn.delete{color:#cf4343;background:#ffebeb}.empty,.empty-cell{text-align:center;color:var(--muted);padding:35px}.compact-courts{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.compact-courts article{display:flex;gap:12px;align-items:center;padding:13px;background:var(--surface);border-radius:10px}.compact-courts article div{flex:1}.compact-courts small{display:block;color:var(--muted);margin-top:4px}.messages{position:fixed;right:25px;top:100px;z-index:100;display:grid;gap:8px}.alert{min-width:290px;display:flex;justify-content:space-between;gap:15px;padding:13px 16px;border-radius:10px;color:#fff;background:#303a49;box-shadow:var(--shadow)}.alert.success{background:#159852}.alert.error{background:#d74646}.alert button{border:0;background:none;color:#fff;font-size:18px}.modal{width:min(620px,calc(100% - 24px));padding:0;border:0;border-radius:17px;box-shadow:0 25px 80px #0005}.modal::backdrop{background:#17203399;backdrop-filter:blur(2px)}.small-modal{width:min(480px,calc(100% - 24px))}.modal-head{display:flex;justify-content:space-between;align-items:flex-start;padding:22px 25px;border-bottom:1px solid var(--line)}.modal-head h2{margin:0 0 4px}.modal-head p{margin:0;color:var(--muted);font-size:12px}.modal-head button{width:34px;height:34px;border:0;border-radius:8px;background:#f2f4f7;color:#6d7683;font-size:20px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px;padding:23px 25px}.form-grid.one-column{grid-template-columns:1fr}.form-grid label{display:grid;gap:7px;font-size:12px;font-weight:700}.form-grid .full{grid-column:1/-1}.form-grid input,.form-grid select,.form-grid textarea{width:100%;border:1px solid #dfe3e9;border-radius:9px;padding:11px 12px;outline:0;background:#fff}.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px #18b95f16}.modal-actions{display:flex;justify-content:flex-end;gap:10px;padding:17px 25px;border-top:1px solid var(--line)}
@media(max-width:1000px){.court-grid{grid-template-columns:repeat(2,1fr)}.metric-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.app-staff{margin-left:0}.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:none}.mobile-menu{display:block;margin-right:auto}.top-search{display:none}.topbar{margin:8px;height:66px}.content,.app-staff .content{width:calc(100% - 24px);padding-top:28px}.welcome,.page-heading{align-items:flex-start}.welcome h1,.page-heading h1{font-size:27px}.court-grid,.metric-grid,.compact-courts{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}.profile-menu summary>span:nth-child(2){display:none}.panel{padding:15px}.messages{left:12px;right:12px}.alert{min-width:0}.client-search{margin-bottom:28px}}
.pay-now-check span{display:flex;align-items:center;gap:8px;color:var(--green-dark)}.pay-now-check input{width:auto}.instant-payment{display:grid;grid-template-columns:1fr 1fr;gap:17px;padding:15px;background:var(--green-soft);border-radius:10px}.instant-payment[hidden]{display:none}@media(max-width:760px){.instant-payment{grid-template-columns:1fr}}
.field-help{color:var(--muted);font-size:10px;font-weight:500}
.cart-button{margin-left:auto;margin-right:18px;display:flex;align-items:center;gap:7px;padding:9px 13px;color:#fff;background:#ffffff1c;border:1px solid #ffffff55;border-radius:10px;font-weight:700}.cart-button b{display:grid;place-items:center;min-width:22px;height:22px;padding:0 6px;color:var(--green-dark);background:#fff;border-radius:999px}.cart-modal{width:min(680px,calc(100% - 24px))}.cart-content{max-height:320px;overflow:auto;padding:18px 24px}.cart-item{display:flex;align-items:center;gap:13px;padding:14px 0;border-bottom:1px solid var(--line)}.cart-sport{display:grid;place-items:center;width:43px;height:43px;background:var(--green-soft);border-radius:11px;font-size:21px}.cart-info{flex:1}.cart-info strong,.cart-info span,.cart-info small{display:block}.cart-info span{margin-top:4px;color:#4e5969}.cart-info small{margin-top:3px;color:var(--muted)}.cart-price{text-align:right}.cart-price strong{display:block;font-size:16px}.cart-price form{margin-top:5px}.cart-price button{border:0;background:none;color:var(--danger);font-size:11px}.empty-cart{text-align:center;padding:28px;color:var(--muted)}.empty-cart>span{font-size:38px}.empty-cart h3{color:var(--ink);margin-bottom:4px}.checkout-form{padding:20px 24px 24px;border-top:1px solid var(--line);background:#fbfcfd}.cart-total{display:flex;justify-content:space-between;align-items:center;padding:16px;margin-bottom:17px;color:#fff;background:linear-gradient(105deg,#10a850,#32d67a);border-radius:12px}.cart-total strong{font-size:24px}.checkout-form h3{font-size:13px;margin:0 0 10px}.wallet-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.wallet{position:relative;display:flex;flex-direction:column;align-items:center;gap:6px;padding:13px;border:2px solid var(--line);border-radius:11px;cursor:pointer;background:#fff}.wallet input{position:absolute;opacity:0}.wallet:has(input:checked){border-color:var(--green);box-shadow:0 0 0 3px #18b95f15}.wallet-logo{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;color:#fff;font-size:21px;font-weight:800}.wallet.yape .wallet-logo{background:#742284}.wallet.plin .wallet-logo{background:#00aeca}.wallet.tunki .wallet-logo{background:#f18a20}.operation-code{display:grid;gap:7px;margin:16px 0 12px;font-size:12px;font-weight:700}.operation-code input{padding:11px;border:1px solid #dfe3e9;border-radius:9px}.checkout-button{font-size:15px}.checkout-note{text-align:center;color:var(--muted);font-size:11px;margin:11px 0 0}@media(max-width:560px){.cart-button{font-size:0;margin-right:8px}.cart-button span,.cart-button b{font-size:13px}.wallet-grid{grid-template-columns:1fr}.cart-item{align-items:flex-start}}
