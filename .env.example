# =============================================
# Variables de Entorno - Proyecto Canchas Fútbol
# =============================================
# Copia este archivo como .env y reemplaza los valores
# cp .env.example .env

# ---- Django ----
DEBUG=True
SECRET_KEY=CAMBIA-ESTO-genera-una-key-con-python-manage-py-shell
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Base de Datos (MySQL) ----
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
#
# MySQL local:
DATABASE_URL=mysql://root:tu_password@localhost:3306/reservas_canchas
#
# MySQL en Railway (reemplaza con tus credenciales):
# DATABASE_URL=mysql://user:password@host.proxy.rlwy.net:port/railway
